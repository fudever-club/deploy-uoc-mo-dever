{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/api/dreams/stream",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/event-stream; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-transform"
        },
        {
          "key": "Connection",
          "value": "keep-alive"
        },
        {
          "key": "X-Accel-Buffering",
          "value": "no"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
